# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.so

# Virtual environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model weights (large binary files — store separately e.g. HuggingFace Hub)
weights/*.pth
weights/*.pt
weights/*.ckpt

# Large datasets and raw images (too large for GitHub)
data/archive/
data/**/*.png
data/**/*.jpg
data/**/*.jpeg

# Experiment outputs / logs (keep results, exclude raw logs)
*.log
logs/

# Environment / secrets
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Multiseed checkpoints (large .pth files, not needed in repo)
experiments/results/multiseed_checkpoints/*.pth

# Temp helper scripts
gen_readme.py
write_readme.py

# Word temp lock files
paper/~$*.docx
paper/~$*.xlsx

# Paper drafts (keep only final)
paper/unwanted/

# Claude settings
.claude/
